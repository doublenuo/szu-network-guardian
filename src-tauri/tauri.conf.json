{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SZU Network Guardian",
  "version": "1.2.2",
  "identifier": "cn.szu.network-guardian",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run check && npm run build:web", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "SZU 网络守护", "width": 820, "height": 900, "minWidth": 620, "minHeight": 720, "resizable": true, "fullscreen": false }], "security": { "csp": null }, "trayIcon": { "iconPath": "icons/icon.png", "iconAsTemplate": false, "tooltip": "SZU Network Guardian" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"], "resources": ["../backend_api.py", "../szu_guardian"], "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "python3", "python3-requests"] } } }
}
